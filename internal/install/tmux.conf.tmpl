# tmux.conf, written by `flok install` as a starting point (github.com/w4jnl/flok).
# A plain, well-behaved tmux: prefix C-a, mouse, vi keys, splits that keep the directory, and a
# few plugins through tpm, which installs itself and them the first time tmux starts (git and a
# network connection once; `prefix I` installs or updates them later). The file is yours: edit it,
# `prefix r` reloads it. flok needs none of it: the sidebar binds its own keys while it runs.
#
# Keys at a glance (prefix = C-a):
#   |  -         split right / below, in the current directory    +   zoom the pane in and out
#   h  j  k      pane left / down / up                              =   tile the panes
#   C-h/j/k/l    the same without the prefix, vim splits included
#   H  J  K  L   resize by 10 (keep pressing)                       s   sessions, sorted by name
#   l   Tab      last window / last session                         r   reload this file
#   Escape       copy mode: v selects, y copies, Y the line, C-y the pane's directory
#   y            type into every pane of the window at once         I   install the plugins (tpm)

# ── terminal ──────────────────────────────────────────────────────────────────────────────────
set -g  default-terminal "tmux-256color"            # 256 colours and italics inside tmux
set -as terminal-overrides ',xterm*:sitm=\E[3m'     # italics on terminals whose terminfo forgot sitm
set -g  set-clipboard on                            # programs may put text on the terminal's clipboard (OSC 52) …
if-shell 'tmux -V | grep -qE "tmux (3\.[2-9]|[4-9])"' "set -as terminal-features ',*:clipboard'"   # … also over ssh (tmux 3.2+)
set -g  history-limit 100000                        # scrollback lines per pane
set -sg escape-time 0                               # Esc reaches vim at once, not after half a second
set -g  focus-events on                             # editors notice when the terminal gains or loses focus
set -g  set-titles on                               # the terminal window title follows the session and window
set -g  set-titles-string "#S · #W"

# ── prefix and basics ─────────────────────────────────────────────────────────────────────────
unbind C-b
set -g  prefix C-a                                  # C-a instead of C-b: one hand, home row
bind    C-a send-prefix                             # C-a C-a sends a C-a through: to a nested tmux, to the shell
set -g  base-index 1                                # windows and panes count from 1, like the keyboard row
setw -g pane-base-index 1
set -g  renumber-windows on                         # closing window 2 of 4 leaves 1 2 3, not 1 3 4
setw -g aggressive-resize on                        # a smaller client elsewhere shrinks only the window it looks at
setw -g monitor-activity on                         # mark windows with output you have not seen …
set -g  visual-activity off                         # … without a message for each
set -g  mouse on                                    # click panes and windows, drag to resize or select, wheel to scroll
setw -g mode-keys vi                                # vi keys in copy mode and the choosers
bind    r source-file {{.Conf}} \; display "config reloaded"

# ── windows and panes ─────────────────────────────────────────────────────────────────────────
bind    | split-window -h -c "#{pane_current_path}" # the new pane starts in this pane's directory
bind    - split-window -v -c "#{pane_current_path}"
bind    h select-pane -L                            # move between panes (l is "last window", see the end)
bind    j select-pane -D
bind    k select-pane -U
bind -r H resize-pane -L 10                         # -r: keep pressing without the prefix
bind -r J resize-pane -D 10
bind -r K resize-pane -U 10
bind -r L resize-pane -R 10
bind    + resize-pane -Z                            # zoom one pane to the whole window, and back
bind    = select-layout tiled                       # every pane the same size
bind    s choose-tree -s -O name                    # the session chooser sorted by name, as flok lists them

# ── copy mode ─────────────────────────────────────────────────────────────────────────────────
bind    Escape copy-mode                            # Escape instead of [ ; in copy mode v selects, y copies
bind    p paste-buffer                              # p pastes (the previous window is prefix l, below)

# ── vim navigator ─────────────────────────────────────────────────────────────────────────────
# C-h C-j C-k C-l move between tmux panes and vim splits alike, no prefix: a pane running vim
# gets the key and vim-tmux-navigator takes it from there (github.com/christoomey/vim-tmux-navigator).
is_vim="ps -o state= -o comm= -t '#{pane_tty}' | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?g?(view|n?vim?x?)(diff)?$'"
bind -n C-h   if-shell "$is_vim" "send-keys C-h"   "select-pane -L"
bind -n C-j   if-shell "$is_vim" "send-keys C-j"   "select-pane -D"
bind -n C-k   if-shell "$is_vim" "send-keys C-k"   "select-pane -U"
bind -n C-l   if-shell "$is_vim" "send-keys C-l"   "select-pane -R"
bind -n 'C-\' if-shell "$is_vim" "send-keys 'C-\\'" "select-pane -l"
bind    C-l send-keys 'C-l'                         # clear the shell's screen, since C-l alone now moves right
bind -T copy-mode-vi C-h   select-pane -L
bind -T copy-mode-vi C-j   select-pane -D
bind -T copy-mode-vi C-k   select-pane -U
bind -T copy-mode-vi C-l   select-pane -R
bind -T copy-mode-vi 'C-\' select-pane -l

# ── plugins (tpm) ─────────────────────────────────────────────────────────────────────────────
set-environment -g TMUX_PLUGIN_MANAGER_PATH "{{.Plugins}}"
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'         # the defaults everyone ends up setting
set -g @plugin 'tmux-plugins/tmux-pain-control'     # consistent pane keys: h j k l, H J K L, | and -
set -g @plugin 'tmux-plugins/tmux-yank'             # copy to the system clipboard, also over ssh
set -g @plugin 'tmux-plugins/tmux-open'             # o in copy mode opens the selected path or URL
set -g @plugin 'tmux-plugins/tmux-resurrect'        # prefix C-s saves the sessions, prefix C-r restores them
set -g @plugin 'tmux-plugins/tmux-continuum'        # saves them every 15 minutes, restores at start
set -g @plugin 'dracula/tmux'                       # the status line, in the palette flok uses too

# plugin options sit ABOVE the tpm line: a plugin reads them once, when tpm loads it
set -g @yank_line 'Y'                               # copy the line with Y (y toggles synchronize-panes, see the end)
set -g @yank_pane_pwd 'C-y'                         # copy the pane's directory with C-y
set -g @resurrect-processes 'ssh psql mysql sqlite3'   # programs a restore starts again
set -g @continuum-restore 'on'
set -g @continuum-save-interval '15'
set -g @dracula-plugins "git cpu-usage ram-usage synchronize-panes"
set -g @dracula-synchronize-panes-refresh-rate 1    # the Sync indicator polls: at 1 s it follows the toggle
set -g @dracula-show-powerline true                 # needs a Nerd Font; false gives plain separators
set -g @dracula-show-flags true
set -g @dracula-show-left-icon session

# tpm installs itself and the plugins at the first start (that start takes a moment); later
# prefix I installs, prefix U updates
if "test ! -d {{.Plugins}}/tpm" "run 'command -v git >/dev/null && git clone -q https://github.com/tmux-plugins/tpm {{.Plugins}}/tpm && {{.Plugins}}/tpm/bin/install_plugins'"
run '{{.Plugins}}/tpm/tpm'

# ── flok ──────────────────────────────────────────────────────────────────────────────────────
# tmux-resurrect saves each Claude Code and Copilot pane with its exact conversation, so a
# restore resumes it (`flok install --tmux-resurrect` prints these lines on their own).
{{.Resurrect}}
# tmux-continuum adds its autosave to status-right only when it believes it is the only tmux
# server; flok's outer server is another one, and dracula resets status-right on every load.
# Put it back, once, below both.
if-shell -F '#{m:*continuum_save.sh*,#{status-right}}' '' 'set -ag status-right "#({{.Plugins}}/tmux-continuum/scripts/continuum_save.sh)"'

# ── after tpm ─────────────────────────────────────────────────────────────────────────────────
# tmux-pain-control binds h j k l and H J K L too, and the plugins load at the tpm line above:
# a binding below it wins, one above it would be replaced without a word. These stay down here.
bind    l last-window                               # the two most recent windows, back and forth
bind    L switch-client -l                          # the two most recent sessions
bind    Tab switch-client -l
bind    y setw synchronize-panes \; display-message "sync-panes #{?pane_synchronized,ON,OFF}"   # type into every pane
