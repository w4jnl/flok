# Generated by `flok up`; edits are overwritten. Personal additions go in {{.ExtraConf}}.
# Lines are gated on the tmux version (internal/tmux/version.go): flok runs on 2.7+, with
# the full feature set from 3.3. An option this tmux does not know would not stop it, but
# tmux shows such errors in a view-mode overlay the user has to dismiss.
# The outer server must stay invisible: no prefix, no status bar, every key and mouse event
# goes to the inner tmux client living in the right pane.
set -g prefix None
set -g prefix2 None
set -g status off
set -g mouse on
set -g set-clipboard on
{{if .F.Passthrough}}set -g allow-passthrough on{{end}}
set -g focus-events on
{{if .F.ExtendedKeys}}set -s extended-keys on{{end}}
{{if .F.ExtendedKeysFormat}}set -s extended-keys-format csi-u{{end}}
set -s escape-time 0
set -g default-terminal "{{.DefaultTerminal}}"
{{if .F.TerminalFeatures}}set -as terminal-features ',xterm-ghostty:RGB:clipboard:extkeys:focus:hyperlinks:mouse:osc7:strikethrough:sync:title:usstyle'
set -as terminal-features ',xterm*:RGB:clipboard:extkeys'{{end}}
set -g set-titles on
set -g set-titles-string "#{?#{m:TMUX*,#{pane_title}},#{pane_title},TMUX - #{pane_title}}"
set -g history-limit 0
{{if .F.WindowSizeLatest}}set -g window-size latest{{end}}
set -g aggressive-resize on
set -g exit-empty on
set -g detach-on-destroy on
set -g remain-on-exit off
# bells from agents (notify.Bell writes BEL into a pane) must reach the terminal, audibly
set -g bell-action any
set -g visual-bell off
{{if .F.BorderLines}}set -g pane-border-lines single{{end}}
set -g pane-border-style 'fg={{.Border}}'
set -g pane-active-border-style 'fg={{.Border}}'
{{if .F.BorderIndicators}}set -g pane-border-indicators off{{end}}
set-environment -g COLORTERM truecolor
{{if .F.FocusHooks}}set-hook -g client-focus-in  "run-shell -b '{{.Bin}} _focus 1'"
set-hook -g client-focus-out "run-shell -b '{{.Bin}} _focus 0'"{{end}}
# tmux scales panes proportionally on every window resize, which would turn the 28-column
# sidebar into 100 after a window manager moves the window around. The sidebar is the "main"
# pane of a main-vertical layout, so re-applying the layout pins its width. `flok toggle`
# changes main-pane-width for the rail. Skipped while the work pane is zoomed (sidebar hidden).
set -g main-pane-width {{.Width}}
{{if .F.ResizedHook}}set-hook -g window-resized "if-shell -F '#{window_zoomed_flag}' '' 'select-layout main-vertical'"{{else}}set-hook -g client-resized "if-shell -F '#{window_zoomed_flag}' '' 'select-layout main-vertical'"{{end}}
set-hook -g client-attached "if-shell -F '#{window_zoomed_flag}' '' 'select-layout main-vertical'"
source-file -q "{{.ExtraConf}}"
