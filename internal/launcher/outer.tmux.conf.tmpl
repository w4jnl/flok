# Generated by `flok up`; edits are overwritten. Personal additions go in {{.ExtraConf}}.
# The outer server must stay invisible: no prefix, no status bar, every key and mouse event
# goes to the inner tmux client living in the right pane.
set -g prefix None
set -g prefix2 None
set -g status off
set -g mouse on
set -g set-clipboard on
set -g allow-passthrough on
set -g focus-events on
set -s extended-keys on
set -s extended-keys-format csi-u
set -s escape-time 0
set -g default-terminal "tmux-256color"
set -as terminal-features ',xterm-ghostty:RGB:clipboard:extkeys:focus:hyperlinks:mouse:osc7:strikethrough:sync:title:usstyle'
set -as terminal-features ',xterm*:RGB:clipboard:extkeys'
set -g set-titles on
set -g set-titles-string "#{?#{m:TMUX*,#{pane_title}},#{pane_title},TMUX - #{pane_title}}"
set -g history-limit 0
set -g window-size latest
set -g aggressive-resize on
set -g exit-empty on
set -g detach-on-destroy on
set -g remain-on-exit off
set -g pane-border-lines single
set -g pane-border-style 'fg={{.Border}}'
set -g pane-active-border-style 'fg={{.Border}}'
set -g pane-border-indicators off
set-environment -g COLORTERM truecolor
set-hook -g client-focus-in  "run-shell -b '{{.Bin}} _focus 1'"
set-hook -g client-focus-out "run-shell -b '{{.Bin}} _focus 0'"
# tmux scales panes proportionally on every window resize, which would turn the 28-column
# sidebar into 100 after a window manager moves the window around. The sidebar is the "main"
# pane of a main-vertical layout, so re-applying the layout pins its width. `flok toggle`
# changes main-pane-width for the rail. Skipped while the work pane is zoomed (sidebar hidden).
set -g main-pane-width {{.Width}}
set-hook -g window-resized "if-shell -F '#{window_zoomed_flag}' '' 'select-layout main-vertical'"
set-hook -g client-attached "if-shell -F '#{window_zoomed_flag}' '' 'select-layout main-vertical'"
source-file -q "{{.ExtraConf}}"
