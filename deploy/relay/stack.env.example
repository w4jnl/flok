# Copy to stack.env (Portainer: paste as the stack's environment variables). Tokens from
# `flok-relay token`, one instance token per flok. Phones need none: they pair with
# `flok phone pair`; a device token is optional, for curl and scripts.
FLOK_HOST=flok.example.net
FLOK_RELAY_INSTANCE_TOKENS=replace-with-flok-relay-token-home,replace-with-flok-relay-token-office
FLOK_RELAY_DEVICE_TOKENS=
# APNs (leave them empty until the app exists; the relay runs without pushes). No sandbox switch:
# each phone says whether it is an Xcode (sandbox) or TestFlight/App Store (production) build.
# the .p8 on one line: base64 -i AuthKey_XXXX.p8 | tr -d '\n'   (Linux: base64 -w0 AuthKey_XXXX.p8)
FLOK_RELAY_APNS_KEY_B64=
FLOK_RELAY_APNS_KEY_ID=
FLOK_RELAY_APNS_TEAM_ID=
FLOK_RELAY_APNS_TOPIC=nl.w4j.flok
# 1 once every flok has [link] pin (docker exec flok-relay /flok-relay pin): plain links refused
FLOK_RELAY_TUNNEL_ONLY=
# Traefik, as your installation names them
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_RESOLVER=letsencrypt
